# PORT=3000
# NODE_ENV=development
# JWT_SECRET=change-me-in-production
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mvuvi
# MQTT_BROKER_URL=mqtt://localhost:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# DEVICE_STATION_ID=mvuvi-station-01

# # Optional: allow all socket connections in dev only
# CORS_ORIGIN=http://localhost:3000


PORT=3000
CORS_ORIGIN=*

# HiveMQ Cloud (use mqtts:// and port 8883)
MQTT_BROKER_URL=mqtts://YOUR-CLUSTER-ID.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=
MQTT_PASSWORD=
# Base topic. Must match the ESP32 sketch exactly (case-sensitive).
MQTT_TOPIC=mvuviGo
# Must match MQTT_CLIENT_ID in the ESP32 sketch
STATION_DEVICE_ID=esp32-rfid-1
STATION_OFFLINE_AFTER_SECONDS=90

# Same PostgreSQL database the FastAPI backend uses.
# Leave empty to run without a database (live dashboard only).
DATABASE_URL=
DB_SSL=false

# Optional: protect /api with the JWT issued by the FastAPI login
AUTH_ENABLED=false
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# SOS handling
SOS_DEDUPE_SECONDS=60
# Optional: called with a JSON body when a new alert is stored (e.g. the AI service)
ALERT_WEBHOOK_URL=

# Only used by the legacy POST /api/cards route
DEFAULT_OPERATOR_ID=